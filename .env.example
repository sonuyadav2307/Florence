# Florence local environment
# Copy to .env.local for development.

# Explicit local demo flag. Never enable this in production.
NEXT_PUBLIC_FLORENCE_DEMO=true

# App origin used for auth redirects. Allowlist internal destinations only.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Supabase (leave empty while using demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Privileged migration credentials belong in the operator environment, not here.
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
